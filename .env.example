# DYNAFIN - OPPORTUNITY IQ
# Environment Configuration Template
# For Stage 2 integration with live Supabase & AI Services

# Application
NEXT_PUBLIC_APP_NAME="DYNAFIN"
NEXT_PUBLIC_APP_TAGLINE="Don't just survive growth. Understand it. Prepare for it. Pursue it."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Configured for Stage 2 Live Connection)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# AI Service Layer (Optional Stage 2 Provider-independent)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Feature Flags
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"
NEXT_PUBLIC_ENABLE_MOCK_STORAGE="true"
